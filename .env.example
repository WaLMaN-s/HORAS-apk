# =============================================================================
# HORAS Backend (Supabase) - Environment Variables Example
# Salin ke `.env` untuk pengembangan lokal (JANGAN pernah commit `.env` nyata).
# =============================================================================

# Koneksi Supabase Project (isi nilai dari `supabase status` untuk lokal,
# atau dari Project Settings -> API di Supabase Dashboard untuk cloud/prod)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Penyedia SMS OTP untuk Supabase Auth (Twilio / Vonage / MessageBird / dll.)
# Lokal menggunakan [auth.sms.test_otp] di supabase/config.toml sehingga SMS berbayar tidak dikirim.
SUPABASE_AUTH_SMS_TWILIO_ACCOUNT_SID=
SUPABASE_AUTH_SMS_TWILIO_AUTH_TOKEN=
SUPABASE_AUTH_SMS_TWILIO_MESSAGE_SERVICE_SID=

# Konfigurasi Edge Functions HORAS
HORAS_OTP_TEST_MODE=true
HORAS_INTERNAL_CRON_SECRET=replace-with-random-secret-for-scheduled-edge-calls
HORAS_MEDIA_MAX_BYTES_POST=10485760
HORAS_MEDIA_MAX_BYTES_CHAT=5242880
